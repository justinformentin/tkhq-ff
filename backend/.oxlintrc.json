{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "node", "promise"],
  "env": {
    "node": true,
    "es2022": true
  },
  "ignorePatterns": ["dist/", "src/grpc/proto/"],
  "rules": {
    "no-unused-vars": "warn",
    "typescript/no-explicit-any": "warn",
    "promise/no-return-wrap": "error"
  }
}
