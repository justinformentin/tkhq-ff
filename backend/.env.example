OPERATOR_AGENT_GRPC_HOST=localhost
OPERATOR_AGENT_GRPC_PORT=4452
PORT=3001

# Deployments register their own Keycloak client; setting these two switches
# off the local loopback sign-in. See the README's Authentication section.
# OIDC_CLIENT_ID=
# OIDC_REDIRECT_URI=https://<your-host>/api/auth/callback
# OIDC_CLIENT_SECRET=
# CORS_ORIGIN=https://<your-host>
# OIDC_IDP_HINT=google
