# Pre-production Environment Configuration
# This file is for pre-production testing environment

# App Configuration
NEXT_PUBLIC_APP_ENV=preprod
NEXT_PUBLIC_APP_NAME=Turnkey Admin Dashboard
NEXT_PUBLIC_APP_VERSION=0.1.0

# Keycloak Authentication (Pre-production)
