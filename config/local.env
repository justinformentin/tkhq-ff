# Local Development Environment Configuration
# This file is for local development only

# App Configuration
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_APP_NAME=Turnkey Admin Dashboard
NEXT_PUBLIC_APP_VERSION=0.1.0

# Keycloak Authentication (Local)
NEXT_PUBLIC_KEYCLOAK_REALM=staff
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=kubelogin
NEXT_PUBLIC_KEYCLOAK_SERVER_URL=https://keycloak.admin.turnkey.engineering
NEXT_PUBLIC_KEYCLOAK_ISSUER=https://keycloak.admin.turnkey.engineering/realms/staff
NEXT_PUBLIC_KEYCLOAK_REDIRECT_URI=http://localhost:3000/auth/callback

# Operator Agent API (Local)
OPERATOR_AGENT_BASE_URL=http://localhost:8081/api/v1
OPERATOR_AGENT_API_KEY=local-dev-key

# Session Configuration
SESSION_SECRET=local-dev-session-secret-change-in-production

# Logging
LOG_LEVEL=debug
