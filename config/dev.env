# Development Environment Configuration
# This file is for shared development environment

# App Configuration
NEXT_PUBLIC_APP_ENV=dev
NEXT_PUBLIC_APP_NAME=Turnkey Admin Dashboard
NEXT_PUBLIC_APP_VERSION=0.1.0

# Keycloak Authentication (Development)
NEXT_PUBLIC_KEYCLOAK_REALM=staff
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=kubelogin
NEXT_PUBLIC_KEYCLOAK_SERVER_URL=https://keycloak.admin.turnkey.engineering
NEXT_PUBLIC_KEYCLOAK_ISSUER=https://keycloak.admin.turnkey.engineering/realms/staff
NEXT_PUBLIC_KEYCLOAK_REDIRECT_URI=http://localhost:3000/auth/callback

# Operator Agent API (Development)
OPERATOR_AGENT_BASE_URL=https://operator-agent-dev.turnkey.com/api/v1
OPERATOR_AGENT_API_KEY=dev-api-key-placeholder

# Session Configuration
SESSION_SECRET=dev-session-secret-placeholder-32chars

# Logging
LOG_LEVEL=debug
